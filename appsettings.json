{
  "Sms": {
    "Provider": "Logging"
  },
  "Notifications": {
    "SmsEnabled": false
  },
  "Demo": {
    "ClockOffsetMinutes": 0
  },
  "Jwt": {
    "Issuer": "Hopon.Api",
    "Audience": "hopon-passenger",
    "ExpiryHours": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Retention": {
    "Enabled": false,
    "DaysAfterTrip": 90,
    "LocationDays": 30,
    "DryRun": true,
    "RunOnStartup": false
  }
}
