{
  "Cors": {
    "AllowedOrigins": []
  },
  "Otp": {
    "ExposeCodeInResponse": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Retention": {
    "Enabled": true,
    "DaysAfterTrip": 90,
    "LocationDays": 30,
    "DryRun": true,
    "RunOnStartup": false
  }
}
