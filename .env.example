# Names only: supply real values through user-secrets or hosting settings.
# ASP.NET Core does not automatically load .env files.
ASPNETCORE_ENVIRONMENT=Production
Jwt__Key=
Jwt__Issuer=Hopon.Api
Jwt__Audience=hopon-passenger
Jwt__ExpiryHours=8
ConnectionStrings__HoponDb=
Admin__Username=
Admin__Password=
Cors__AllowedOrigins__0=
Otp__ExposeCodeInResponse=false
# Azure Linux App Service only, behind its trusted managed proxy:
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# Logging is the safe default. Twilio sends OTPs even with notification SMS off.
Sms__Provider=Logging
Twilio__AccountSid=
Twilio__AuthToken=
Twilio__FromNumber=
Twilio__MessagingServiceSid=
Notifications__SmsEnabled=false
# Optional replacement list; omit all entries to use the defaults.
# Notifications__SmsTypes__0=ThirtyMinutesBefore
# Notifications__SmsTypes__1=TenMinutesBefore
# Notifications__SmsTypes__2=Arrival
# Notifications__SmsTypes__3=Delay
# Notifications__SmsTypes__4=Emergency
