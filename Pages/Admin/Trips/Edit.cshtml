@page "{id:int}"
@model Hopon.Api.Pages.Admin.Trips.EditModel
@{
    ViewData["Title"] = "Edit Trip";
}

<h1>Edit Trip</h1>

@if (Model.LifecycleError != null)
{
    <p class="text-error" role="alert">@Model.LifecycleError</p>
}

<form method="post" class="hopon-form" style="max-width:480px;">
    <div asp-validation-summary="All" class="text-error"></div>

    <label>Route</label>
    <select asp-for="Input.BusRouteId" asp-items="Model.RouteItems"></select>

    <label>Bus</label>
    <select asp-for="Input.BusId" asp-items="Model.BusItems"></select>

    <label>Driver</label>
    <select asp-for="Input.DriverId" asp-items="Model.DriverItems">
        <option value="">Unassigned</option>
    </select>

    <label>Scheduled Departure (SAST)</label>
    <input asp-for="Input.ScheduledDeparture" type="datetime-local" />

    <label>Scheduled Arrival (SAST)</label>
    <input asp-for="Input.ScheduledArrival" type="datetime-local" />

    <button type="submit" class="btn-primary">Save Changes</button>
</form>

@if (TripStatusRules.CanTransition(Model.Status, TripStatus.Delayed))
{
    <form method="post" asp-page-handler="MarkDelayed" asp-route-id="@Model.Id" class="hopon-form" style="max-width:480px; margin-top:1rem;">
        <label asp-for="DelayReason">Delay reason (optional)</label>
        <input asp-for="DelayReason" />
        <button type="submit" class="btn-secondary">Mark as Delayed</button>
    </form>
}
@if (Model.Status == TripStatus.Delayed && TripStatusRules.CanTransition(Model.Status, TripStatus.InProgress))
{
    <form method="post" asp-page-handler="Resume" asp-route-id="@Model.Id" style="display:inline; margin-top:1rem;">
        <button type="submit" class="btn-secondary">Resume</button>
    </form>
}
@if (TripStatusRules.CanTransition(Model.Status, TripStatus.Completed))
{
    <form method="post" asp-page-handler="MarkCompleted" asp-route-id="@Model.Id" style="display:inline; margin-top:1rem;">
        <button type="submit" class="btn-secondary">Mark as Completed</button>
    </form>
}
