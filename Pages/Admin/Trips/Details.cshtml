@page "{id:int}"
@model Hopon.Api.Pages.Admin.Trips.DetailsModel
@{
    ViewData["Title"] = "Trip Details";
}

@if (Model.Trip is null)
{
    <p>Trip not found.</p>
}
else
{
    var trip = Model.Trip;
    <h1>@trip.RouteName</h1>
    <p><span class="badge">@trip.Status</span></p>

    @if (Model.LifecycleError != null)
    {
        <p class="text-error" role="alert">@Model.LifecycleError</p>
    }

    <table class="hopon-table">
        <tr><th>Bus</th><td>@trip.BusRegistration</td></tr>
        <tr><th>Driver</th><td>@(trip.DriverName ?? "Unassigned")</td></tr>
        <tr><th>Scheduled Departure (SAST)</th><td>@SaTime.ToSa(trip.ScheduledDeparture).ToString("dd MMM yyyy, HH:mm")</td></tr>
        <tr><th>Scheduled Arrival (SAST)</th><td>@SaTime.ToSa(trip.ScheduledArrival).ToString("dd MMM yyyy, HH:mm")</td></tr>
        <tr><th>Actual Departure (SAST)</th><td>@(trip.ActualDeparture.HasValue ? SaTime.ToSa(trip.ActualDeparture.Value).ToString("dd MMM yyyy, HH:mm") : "—")</td></tr>
        <tr><th>Actual Arrival (SAST)</th><td>@(trip.ActualArrival.HasValue ? SaTime.ToSa(trip.ActualArrival.Value).ToString("dd MMM yyyy, HH:mm") : "—")</td></tr>
    </table>

    <div style="margin-top:1rem;">
        @if (trip.Status is "Scheduled" or "Delayed" or "InProgress")
        {
            <a class="btn-secondary" asp-page="./Edit" asp-route-id="@trip.TripId">Edit Trip</a>
            <details style="margin-top:1rem;">
                <summary>Cancel Trip</summary>
                <form method="post" asp-page-handler="Cancel" asp-route-id="@trip.TripId" class="hopon-form" style="max-width:480px;" onsubmit="return confirm('Cancel this trip and notify ticket holders?');">
                    <label asp-for="CancellationReason">Cancellation reason (optional)</label>
                    <input asp-for="CancellationReason" />
                    <button type="submit" class="btn-danger">Confirm cancellation</button>
                </form>
            </details>
        }
    </div>

    <h2 style="margin-top:2rem;">Tickets (@trip.Tickets.Count)</h2>
    <table class="hopon-table">
        <thead><tr><th>Reference</th><th>Passenger</th><th>Seat</th><th>Destination stop</th><th>Scheduled arrival (SAST)</th><th>Active</th></tr></thead>
        <tbody>
            @foreach (var ticket in trip.Tickets)
            {
                <tr>
                    <td>@ticket.TicketReference</td>
                    <td>@ticket.PassengerName</td>
                    <td>@(ticket.SeatNumber ?? "—")</td>
                    <td>@(ticket.DestinationStopName ?? "—")</td>
                    <td>@(ticket.DestinationScheduledArrival.HasValue ? SaTime.ToSa(ticket.DestinationScheduledArrival.Value).ToString("dd MMM yyyy, HH:mm") : "—")</td>
                    <td>@(ticket.IsActive ? "Yes" : "No")</td>
                </tr>
            }
            @if (!trip.Tickets.Any())
            {
                <tr><td colspan="6">No tickets booked yet.</td></tr>
            }
        </tbody>
    </table>

    @if (trip.Status is "Scheduled" or "Delayed" or "InProgress")
    {
        <h2 style="margin-top:2rem;">Issue Ticket</h2>

        @if (Model.TripStopItems.Count < 2)
        {
            <p>This trip needs at least two stops before tickets can be issued.</p>
        }
        else if (Model.PassengerItems.Count == 0)
        {
            <p>Every active passenger already holds a ticket for this trip.</p>
        }
        else
        {
            <form method="post" asp-page-handler="IssueTicket" asp-route-id="@trip.TripId" class="hopon-form" style="max-width:480px;">
                <div asp-validation-summary="All" class="text-error"></div>

                <label>Passenger</label>
                <select asp-for="Input.UserId" asp-items="Model.PassengerItems">
                    <option value="">Select a passenger</option>
                </select>

                <label asp-for="Input.OriginTripStopId">Boarding stop (optional)</label>
                <select asp-for="Input.OriginTripStopId" asp-items="Model.TripStopItems">
                    <option value="">First stop (default)</option>
                </select>

                <label asp-for="Input.DestinationTripStopId">Destination stop</label>
                <select asp-for="Input.DestinationTripStopId" asp-items="Model.TripStopItems">
                    <option value="">Select a destination stop</option>
                </select>

                <label asp-for="Input.SeatNumber">Seat number (optional)</label>
                <input asp-for="Input.SeatNumber" maxlength="10" placeholder="e.g. 14A" />

                <button type="submit" class="btn-primary" style="margin-top:1rem;">Issue Ticket</button>
            </form>
        }
    }
}

