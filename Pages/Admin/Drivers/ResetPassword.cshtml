@page "{id:int}"
@model Hopon.Api.Pages.Admin.Drivers.ResetPasswordModel
@{
    ViewData["Title"] = "Reset driver password";
}
<h1>Reset password</h1>
<p>Set a new password for @Model.Driver.FullName (@Model.Driver.Username).</p>
<form method="post" class="hopon-form staff-form">
    <div asp-validation-summary="All" class="text-error" role="alert"></div>
    <label asp-for="Password">New password (at least 8 characters)</label>
    <input asp-for="Password" autocomplete="new-password" minlength="8" />
    <button type="submit" class="btn-primary">Reset password</button>
</form>
<p><a asp-page="Index">Back to drivers</a></p>
