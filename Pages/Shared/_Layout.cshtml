@{
    var theme = Context.Request.Cookies["hopon-theme"] == "dark" ? "dark" : "light";
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Hopon Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="hopon-header">
        <div class="hopon-brand">Hopon <span>Admin</span></div>
        <nav class="hopon-nav">
            <a asp-page="/Admin/Trips/Index">Trips</a>
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button">Theme</button>
    </header>
    <main class="hopon-main">
        @RenderBody()
    </main>
    <script src="~/js/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
