@using Hopon.Api.Services
@using Microsoft.AspNetCore.Authentication
@{
    var staff = (await Context.AuthenticateAsync(StaffCookieEvents.Scheme)).Principal;
    var theme = Context.Request.Cookies["hopon-theme"] == "dark" ? "dark" : "light";
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Hopon Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="hopon-header">
        <div class="hopon-brand">Hopon <span>Staff</span></div>
        <nav class="hopon-nav">
            @if (staff?.IsInRole("Admin") == true)
            {
                <a asp-page="/Admin/Index">Home</a>
                <a asp-page="/Admin/Monitor">Live monitor</a>
                <a asp-page="/Admin/Trips/Index">Trips</a>
                <a asp-page="/Admin/Notifications">Notifications</a>
                <a asp-page="/Admin/Audit">Access audit</a>
                <a asp-page="/Admin/Buses/Index">Buses</a>
                <a asp-page="/Admin/Stops/Index">Stops</a>
                <a asp-page="/Admin/Routes/Index">Routes</a>
                <a asp-page="/Admin/Drivers/Index">Drivers</a>
            }
            @if (staff?.IsInRole("Driver") == true)
            {
                <a asp-page="/Driver/Trip">My trip</a>
            }
        </nav>
        <partial name="/Pages/Shared/_StaffAccount.cshtml" />
        <button id="theme-toggle" class="theme-toggle" type="button">Theme</button>
    </header>
    <main class="hopon-main">
        @RenderBody()
    </main>
    <script src="~/js/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
