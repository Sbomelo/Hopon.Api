@using Hopon.Api.Services
@using Microsoft.AspNetCore.Authentication
@{
    var staff = (await Context.AuthenticateAsync(StaffCookieEvents.Scheme)).Principal;
    var theme = Context.Request.Cookies["hopon-theme"] == "dark" ? "dark" : "light";
    var isAdmin = staff?.IsInRole("Admin") == true;
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Hopon Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="hopon-header @(isAdmin ? "hopon-header--admin" : null)">
        @if (isAdmin)
        {
            <a class="hopon-brand" asp-page="/Admin/Index" aria-label="Hopon Staff home">Hopon <span>Staff</span></a>
        }
        else
        {
            <div class="hopon-brand">Hopon <span>Staff</span></div>
        }
        @if (staff?.IsInRole("Driver") == true)
        {
            <nav class="hopon-nav" aria-label="Driver navigation">
                <a asp-page="/Driver/Trip">My trip</a>
            </nav>
        }
        <partial name="/Pages/Shared/_StaffAccount.cshtml" />
        <button id="theme-toggle" class="theme-toggle" type="button">Theme</button>
    </header>
    @if (isAdmin)
    {
        <div class="admin-shell">
            <aside class="admin-sidebar">
                <partial name="/Pages/Shared/_AdminNavigation.cshtml" />
            </aside>
            <details class="admin-nav-disclosure">
                <summary>Admin navigation</summary>
                <partial name="/Pages/Shared/_AdminNavigation.cshtml" />
            </details>
            <main class="hopon-main admin-main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="hopon-main">
            @RenderBody()
        </main>
    }
    <script src="~/js/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
